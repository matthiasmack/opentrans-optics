			<QUANTITY>100</QUANTITY>
			<bmecat:ORDER_UNIT>C62</bmecat:ORDER_UNIT>
			<PRODUCT_PRICE_FIX>
				<bmecat:PRICE_AMOUNT>0.15</bmecat:PRICE_AMOUNT>
				<bmecat:PRICE_QUANTITY>1</bmecat:PRICE_QUANTITY>
			</PRODUCT_PRICE_FIX>
			<PRICE_LINE_AMOUNT>15.00</PRICE_LINE_AMOUNT>
			<ITEM_UDX>
				<UDX.CUSTOM xmlns="urn:example:udx">
					<COST_CENTER>cc-42</COST_CENTER>
				</UDX.CUSTOM>
			</ITEM_UDX>
		</ORDER_ITEM>
		<ORDER_ITEM>
			<LINE_ITEM_ID>2</LINE_ITEM_ID>
			<PRODUCT_ID>
				<bmecat:SUPPLIER_PID>SKU-B</bmecat:SUPPLIER_PID>
				<bmecat:DESCRIPTION_SHORT>Mutter M4</bmecat:DESCRIPTION_SHORT>
			</PRODUCT_ID>
			<QUANTITY>2.5</QUANTITY>
			<bmecat:ORDER_UNIT>KGM</bmecat:ORDER_UNIT>
			<PRODUCT_PRICE_FIX>
				<bmecat:PRICE_AMOUNT>12.40</bmecat:PRICE_AMOUNT>
			</PRODUCT_PRICE_FIX>
			<PRICE_LINE_AMOUNT>31.00</PRICE_LINE_AMOUNT>
			<REMARKS type="order">deliver separately</REMARKS>
		</ORDER_ITEM>
	</ORDER_ITEM_LIST>
	<ORDER_SUMMARY>
		<TOTAL_ITEM_NUM>2</TOTAL_ITEM_NUM>
		<TOTAL_AMOUNT>46.00</TOTAL_AMOUNT>
	</ORDER_SUMMARY>
</ORDER>
